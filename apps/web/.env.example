# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
# These values are public by design (they identify the project, they do not
# grant access); access control lives in firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to route Auth/Firestore/Functions at the local emulator suite.
VITE_USE_FIREBASE_EMULATORS=false
